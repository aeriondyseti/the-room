# Machine-specific participant registry (see proposal.md)
session.toml
# Room runtime data
.room/
# Worktrees live beside the trunk's checkout, never inside it; this catches one a harness makes here.
.claude/worktrees/
# pair-poc message log
.room-poc/
# Build output and dependencies
node_modules/
dist/
# Frozen dist copy for long acceptance runs (scripts/acceptance/run.mjs, VP_DIST)
.acceptance-dist/
# Node
*.tsbuildinfo

# Registry replacement files can remain after an interrupted process
session.toml.*.tmp
